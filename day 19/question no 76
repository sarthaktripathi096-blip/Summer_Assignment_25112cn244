import java.util.Arrays;

public class DiagonalSum {
    
    // Method to find the sum of diagonal elements
    static int diagonalSum(int[][] matrix) {
        int sum = 0;
        int n = matrix.length;
        
        // Add diagonal elements (where row index = column index)
        for (int i = 0; i < n; i++) {
            sum += matrix[i][i];
        }
        
        return sum;
    }
    
    // Method to print matrix
    static void printMatrix(int[][] matrix) {
        for (int[] row : matrix) {
            for (int num : row) {
                System.out.print(num + " ");
            }
            System.out.println();
        }
    }
    
    // Main method
    public static void main(String[] args) {
        // Define a square matrix
        int[][] matrix = {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };
        
        System.out.println("Matrix:");
        printMatrix(matrix);
        
        // Find diagonal sum
        int result = diagonalSum(matrix);
        
        System.out.println("\nDiagonal elements: 1, 5, 9");
        System.out.println("Diagonal sum: " + result);
    }
}
