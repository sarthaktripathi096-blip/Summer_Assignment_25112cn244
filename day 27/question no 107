public class Employee {
    private int id;
    private String name;
    private double basicSalary;
    private double bonus;
    private double deduction;

    public Employee(int id, String name, double basicSalary, double bonus, double deduction) {
        this.id = id;
        this.name = name;
        this.basicSalary = basicSalary;
        this.bonus = bonus;
        this.deduction = deduction;
    }

    public int getId() { return id; }
    public String getName() { return name; }
    public double getBasicSalary() { return basicSalary; }
    public double getBonus() { return bonus; }
    public double getDeduction() { return deduction; }

    public void setName(String name) { this.name = name; }
    public void setBasicSalary(double basicSalary) { this.basicSalary = basicSalary; }
    public void setBonus(double bonus) { this.bonus = bonus; }
    public void setDeduction(double deduction) { this.deduction = deduction; }

    public double calculateNetSalary() {
        return basicSalary + bonus - deduction;
    }

    @Override
    public String toString() {
        return "ID: " + id +
               ", Name: " + name +
               ", Basic Salary: " + basicSalary +
               ", Bonus: " + bonus +
               ", Deduction: " + deduction +
               ", Net Salary: " + calculateNetSalary();
    }
}
